# Isolates this stack's Docker Compose project/containers/volumes from the
# sibling flow-connect and mgses repos (they share the "backend" folder name,
# which Compose would otherwise use as a shared default project name).
COMPOSE_PROJECT_NAME=si-ptik-backend

# ── Server ──
PORT=8080

# ── PostgreSQL ──
POSTGRES_USER=ptik
POSTGRES_PASSWORD=ptik_secret
POSTGRES_DB=ptik_dev
POSTGRES_PORT=5435
DATABASE_URL=postgres://ptik:ptik_secret@localhost:5435/ptik_dev?sslmode=disable

# ── API port (host-side, mapped to container :8080) ──
API_PORT=8083

# ── JWT (>= 32 chars; generate with: openssl rand -hex 32) ──
JWT_SECRET=replace_me_with_at_least_32_character_secret_key_here
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=336h

# ── CORS (comma-separated). Any http://localhost origin is always allowed. ──
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ── Seed (cmd/seed) ──
SEED_ADMIN_EMAIL=admin@ptik.id
SEED_ADMIN_PASSWORD=admin12345
